server:
  host: "0.0.0.0"
  port: 8080
  mode: "debug"  # debug, release

database:
  driver: "sqlite"  # sqlite, mysql, postgres
  dsn: "fluent_manager.db"
  # MySQL: "user:pass@tcp(127.0.0.1:3306)/fluent_manager?charset=utf8mb4&parseTime=True"
  # Postgres: "host=localhost user=fm password=fm dbname=fluent_manager port=5432 sslmode=disable"

auth:
  jwt_secret: "your-secret-key-change-in-production"
  token_expire_hours: 24

  ldap:
    enabled: false
    host: "ldap.example.com"
    port: 389
    use_tls: false
    bind_dn: "cn=admin,dc=example,dc=com"
    bind_password: "admin_password"
    base_dn: "dc=example,dc=com"
    user_filter: "(uid=%s)"
    group_filter: "(memberUid=%s)"
    attributes:
      username: "uid"
      email: "mail"
      name: "cn"

  saml:
    enabled: false
    idp_metadata: "https://idp.example.com/metadata"
    entity_id: "https://fluent-manager.example.com"
    acs_url: "https://fluent-manager.example.com/saml/acs"
    cert_file: "/etc/fluent-manager/saml.crt"
    key_file: "/etc/fluent-manager/saml.key"

agent:
  heartbeat_interval: 30    # seconds
  sync_interval: 60         # reserved for future server-side reconciliation loops
  metrics_interval: 60      # seconds
  log_upload_interval: 120  # seconds
  log_buffer_lines: 500
  health_port: 9880
  max_retries: 5
  retry_base_delay: 1000    # milliseconds
  api_key: ""                # deprecated legacy fallback; prefer creating managed agent keys in the UI
  fluent_type: ""           # optional: empty = agent auto-detects
  fluent_config_path: ""
  fluent_config_dir: ""
  fluent_binary: ""
  fluent_service_unit: ""
  fluent_restart_cmd: ""
  fluent_reload_cmd: ""
  fluent_dry_run_cmd: ""
  fluent_log_path: ""
  fluent_extra_files: []
  fluent_metrics_url: ""
  fluent_metrics_format: ""
  backup_dir: ""
  max_backups: 10

fluent:
  shared_key_secret: "use-a-dedicated-secret-in-production"  # optional, falls back to auth.jwt_secret if empty

cache:
  enabled: false            # enable Redis caching for metrics aggregation
  addr: "localhost:6379"
  password: ""
  db: 0
  ttl: 30                  # cache TTL in seconds

log:
  level: "info"
  file: ""  # empty = stdout
