server_url: "http://fluent-manager-server:8080"
api_key: "your-agent-api-key"

# Leave empty to auto-generate a persistent unique ID
node_uid: ""

# Fluent configuration
fluent_type: "fluentbit"  # fluentbit or fluentd
fluent_config_path: "/etc/fluent-bit/fluent-bit.conf"
fluent_config_dir: ""      # optional: directory for extra config files
fluent_binary: ""          # auto-detected: fluent-bit or fluentd
fluent_restart_cmd: "systemctl restart fluent-bit"
fluent_reload_cmd: "systemctl reload fluent-bit"   # graceful reload via SIGHUP
fluent_dry_run_cmd: ""     # auto-detected: fluent-bit --dry-run -c <path>
fluent_log_path: "/var/log/fluent-bit.log"
fluent_extra_files: []     # additional managed config files

# Timing intervals (seconds)
heartbeat_interval: 30     # how often to send heartbeat to server
metrics_interval: 60       # how often to collect system metrics
log_upload_interval: 120   # how often to upload fluent log lines
log_buffer_lines: 500      # max log lines to buffer before upload

# Local health check endpoint (127.0.0.1 only)
# Endpoints: /health, /metrics, /config, /info
health_port: 9880

# Retry settings for server communication
max_retries: 5
retry_base_delay: 1000     # milliseconds (exponential backoff: 1s, 2s, 4s, 8s, 16s)

# Config backup
backup_dir: "/var/lib/fluent-manager/backups"
max_backups: 10            # keep N most recent backups

# Node labels (JSON key-value)
labels: '{"env":"production","dc":"us-east-1","team":"infra"}'
